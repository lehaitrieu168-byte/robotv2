# Sao chép file này thành .env rồi chỉnh nếu cần. KHÔNG để secret/API key ở đây.

# Máy chủ
HOST=0.0.0.0
PORT=8000

# Model: int8 (mặc định, nhanh trên CPU) hoặc fp32 (chất lượng cao nhất, nặng hơn)
VIENEU_PRECISION=int8

# Bật nhân bản giọng (cần PyTorch được cài). Đặt false nếu chỉ dùng giọng dựng sẵn.
ENABLE_CLONING=true

# Nạp sẵn model khi khởi động (nên đặt true khi demo với robot ESP32)
PRELOAD_MODEL=false

# Giới hạn để tránh lạm dụng khi mở ra mạng
MAX_CHARS=1000
MAX_REF_SECONDS=30

# Nơi cache model HuggingFace (trong Docker đã map sẵn vào /models)
HF_HOME=/models
